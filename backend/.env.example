# Copiá este archivo como .env y completá con tus datos reales

# URL de conexión a PostgreSQL (Supabase)
# La encontrás en: Supabase → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Tu Gmail desde el que se van a enviar los pedidos
GMAIL_USER=tu_email@gmail.com

# Contraseña de aplicación de Gmail (NO tu contraseña normal)
# Cómo obtenerla: myaccount.google.com → Seguridad → Verificación en 2 pasos → Contraseñas de aplicación
GMAIL_PASS=xxxx_xxxx_xxxx_xxxx

# Tu email donde querés RECIBIR los pedidos (puede ser el mismo)
EMAIL_DESTINO=tu_email@gmail.com

# Tu número de WhatsApp con código de país, sin + ni espacios
# Ejemplo Argentina: 5491155556666
WHATSAPP_NUMERO=549XXXXXXXXXX

# Puerto del servidor (dejalo en 3001)
PORT=3001
